/ ================================================================
// Rxqu3stPATH SCRIPT V2
// RDR2 - Cronus Zen Script (Xbox layout)
//  Zen Studio: File
//  then program to a slot. Uses classic Zen GPC (printf + SPVAR saves).
// ================================================================
//  TOGGLES  (hold VIEW + press button)      rumble: 1 strong = ON, weak = OFF
//    VIEW + LT      AIM_ASSIST  (LT re-tap snap while aiming)
//    VIEW + RT      RS_PRESS    (auto Dead Eye on aim)
//    VIEW + X       RT_PRESS    (rapid fire while RT held)
//    VIEW + A       RUN_HORSE   (hold A = auto tap A to gallop)
//    VIEW + Y       HAT         (D-pad Up = hat pickup/put on)
//    VIEW + B       TONICS      (D-pad Right tap = use tonic)
//    VIEW + DOWN    tonicspam   (hold RB = spam tonic)
//    VIEW + LEFT    basespin    (hold D-pad Left = 360 spin)
//    VIEW + RB      autospin_right
//    VIEW + LB      autospin_left
//    VIEW + RIGHT   LOW_BATTERY (anti-idle nudge every ~2s)
//    VIEW + UP      cycle aim distance: BASE > PLUS > MIDDLE > LONG
//    VIEW tap       normal VIEW press (sent after a 0.3s double-tap check)
//    VIEW double-tap  HELP pages: D-pad Left/Right = page, B = close
//    VIEW + LS tap  next PROFILE: PVP > HUNT > HORSE (each keeps its own
//                   toggles, aim distance and timings)
//    VIEW + LS + RS (hold 1.5s)  FACTORY RESET of the ACTIVE profile: all mods
//                   off, aim distance BASE, all timings back to original values
//
//  TIMING EDIT (VIEW + MENU to enter, live, no recompile)
//    D-pad Left/Right  pick mod        D-pad Up/Down  +/- 5 ms (hold = repeat, speeds up after 1.5s)
//    hold RB + Up/Down +/- 50 ms       Y  reset offset to 0
//    B or MENU         save & exit     (offset applies to min AND max)
//
//  SAVER: after 60s with no changes the OLED blanks to a small drifting
//         logo; any toggle (or pressing VIEW) wakes the menu.
//
//  LED: RED = combat mods, GREEN = movement mods, BLUE = utility mods
//       (colors mix, brighter = more on), WHITE = timing edit, dim = all off
//       Switching a mod flashes WHITE: 1 flash = ON, 2 flashes = OFF
//       Xbox pads have no light bar, so this shows on the Zen's LED.
//
//  POPUP: switching a mod flashes "<MOD> ON/OFF" on the OLED for ~1s
//
//  BOOT: ~3s animated RXQU3STPATH splash, then the mod menu
//  SAVE: toggles + aim distance auto-save when you release VIEW,
//        and reload on power-up / replug (SPVAR_1 - SPVAR_52).
//  OLED: "RXQU3STPATH" header, mod grid (filled box = ON), aim distance
//
//  VALUES (steps | min ms | max ms)
//    AIM_ASSIST 4|681|690   HAT 6|859|880        LOW_BATTERY 3|2001|2010
//    RUN_HORSE 3|151|160    RT_PRESS 3|101|110   RS_PRESS 4|N/A|N/A
//    TONICS 4|241|250       LONG_DISTANCE 3|N/A  PLUS_DISTANCE 2|41|50
//    MIDDLE_DISTANCE 4|381|390  vibrate 2|201|210  tonicspam 3|111|130
//    basespin 22|531|540    autospin_right 3|582|600  autospin_left 4|662|680
// ================================================================

//███████████████████████████████████████████████████████████████████
//▄─▄▄▀█▄─▀─▄█─▄▄▄─█▄─██─▄█▄▄▄░█─▄▄▄▄█─▄─▄─███▄─▄▄─██▀▄─██─▄─▄─█─█─█
//██─▄─▄██▀─▀██─██▀─██─██─███▄▄░█▄▄▄▄─███─██████─▄▄▄██─▀─████─███─▄─█
//▀▄▄▀▄▄▀▄▄█▄▄▀───▄▄▀▀▄▄▄▄▀▀▄▄▄▄▀▄▄▄▄▄▀▀▄▄▄▀▀▀▀▄▄▄▀▀▀▄▄▀▄▄▀▀▄▄▄▀▀▄▀▄▀

// ---- Editable in-game button mapping ----
define HAT_BTN      = XB1_Y;
define TONIC_WHEEL  = XB1_LB;
define TONIC_TAB    = XB1_RB;
define TONIC_USE    = XB1_A;
define DEADEYE_BTN  = XB1_RS;

// ---- Timings (base min/max ms, N/A values use defaults) ----
//  idx: 0 AIM  1 PLUS  2 MIDDLE  3 LONG  4 RS  5 RT  6 HORSE  7 HAT
//       8 TONICS  9 TSPAM  10 SPIN  11 ASR  12 ASL  13 BATTERY  14 VIBRATE
const int16 T_MIN[] = { 681, 41, 381, 900, 60, 101, 151, 859, 241, 111, 531, 582, 662, 2001, 201 };
const int16 T_MAX[] = { 690, 50, 390, 900, 60, 110, 160, 880, 250, 130, 540, 600, 680, 2010, 210 };
define T_COUNT = 15;
define SPIN_STEPS = 22;
define T_FLOOR = 10;
define OFF_LIMIT = 1000;
define STEP_SMALL = 5;
define STEP_BIG = 50;
define MAGIC = 4242;

define TAP = 40;
define DZ = 20;
define ACTIVE_INDEX = 0;
define PROFILE_BASE = 1;
define PROFILE_SIZE = 17;
define PROFILE_MAGIC_OFS = 16;
define PROFILE_COUNT = 3;
define POPUP_PROFILE = 97;
// First-use presets (mask): PVP = AIM+RS+RT, dist PLUS | HUNT = AIM+RS+TONICS, dist LONG | HORSE = RUN HORSE+HAT
const int16 PRESET[] = { 2055, 6179, 24 };
const string P0 = "PVP";
const string P1 = "HUNT";
const string P2 = "HORSE";
const string S_PROFILE = "PROFILE";
define SAVE_MAX = 8191;

// ---- OLED text ----
const string TITLE = "RXQU3STPATH";
const string S_AIM = "AIM";
const string S_RS  = "RS";
const string S_RT  = "RT";
const string S_HRS = "HRS";
const string S_HAT = "HAT";
const string S_TON = "TON";
const string S_SPM = "SPM";
const string S_SPN = "SPN";
const string S_ASR = "ASR";
const string S_ASL = "ASL";
const string S_BAT = "BAT";
const string S_DIST = "DIST:";
const string S_BASE = "BASE";
const string S_PLUS = "PLUS";
const string S_MID  = "MIDDLE";
const string S_LONG = "LONG";
const string S_SUB  = "RDR2 ZEN SCRIPT";
const string S_EDIT = "TIMING EDIT";
const string S_BASEL = "BASE";
const string S_OFFS = "OFFS";
const string S_NOW  = "NOW";
const string N0  = "AIM ASSIST";
const string N1  = "PLUS DIST";
const string N2  = "MIDDLE DIST";
const string N3  = "LONG DIST";
const string N4  = "RS PRESS";
const string N5  = "RT PRESS";
const string N6  = "RUN HORSE";
const string N7  = "HAT";
const string N8  = "TONICS";
const string N9  = "TONIC SPAM";
const string N10 = "BASE SPIN";
const string N11 = "AUTOSPIN R";
const string N12 = "AUTOSPIN L";
const string N13 = "LOW BATTERY";
const string N14 = "VIBRATE";
const string S_ON    = "ON";
const string S_OFF   = "OFF";
const string S_ADIST = "AIM DIST";
define POPUP_MS = 900;
define REPEAT_DELAY = 400;
define REPEAT_RATE = 100;
define REPEAT_TURBO = 40;
define REPEAT_TURBO_AFTER = 1500;
define POPUP_DIST = 99;
define POPUP_RESET = 98;
define RESET_HOLD_MS = 1500;
const string S_RESET = "RESET ALL";
const string S_DONE  = "DONE";
const string HH0 = "HOLD VIEW +";
const string HH1 = "USING MODS";
const string HH2 = "TIMING EDIT";
const string H0 = "LT    AIM ASSIST";
const string H1 = "RT    DEADEYE";
const string H2 = "X     RAPID FIRE";
const string H3 = "A     RUN HORSE";
const string H4 = "Y     HAT";
const string H5 = "B     TONICS";
const string H6 = "DOWN  TONIC SPAM";
const string H7 = "LEFT  BASE SPIN";
const string H8 = "RB    AUTOSPIN R";
const string H9 = "LB    AUTOSPIN L";
const string H10 = "RIGHT LOW BATTERY";
const string H11 = "UP    AIM DIST";
const string H12 = "MENU  TIMING EDIT";
const string H13 = "LS    NEXT PROFILE";
const string H14 = "LS+RS HOLD RESET";
const string H15 = "LT    AIM+DEADEYE";
const string H16 = "RT    RAPID FIRE";
const string H17 = "HOLD A  GALLOP";
const string H18 = "UP    HAT";
const string H19 = "RIGHT TONIC RB SPM";
const string H20 = "LEFT  BASE SPIN";
const string H21 = "AUTOSPIN IS AUTO";
const string H22 = "VIEW X2  THIS HELP";
const string H23 = "LT PAUSES AUTOSPIN";
const string H24 = "MOVE RS PAUSES TOO";
const string H25 = "LF RT  PICK MOD";
const string H26 = "UP DN  5MS STEP";
const string H27 = "RB+UP DN 50MS";
const string H28 = "Y      RESET MOD";
const string H29 = "B      SAVE+EXIT";
define HELP_PAGES = 6;
define DOUBLE_TAP_MS = 300;
define SAVER_MS = 60000;
define FLASH_ON_MS = 120;
define FLASH_GAP_MS = 80;
define SAVER_MOVE_MS = 4000;

// ---- Boot splash: "RXQU3STPATH" as ASCII, ~3s at 100ms per frame ----
const int8 SPLASH[] = { 82, 88, 81, 85, 51, 83, 84, 80, 65, 84, 72 };
define SPLASH_LEN = 11;
define SPLASH_FRAMES = 30;
define SPLASH_FRAME_MS = 100;

// ---- Toggle states ----
int aim_on = 0;
int hat_on = 0;
int bat_on = 0;
int horse_on = 0;
int rt_on = 0;
int rs_on = 0;
int tonic_on = 0;
int tspam_on = 0;
int spin_on = 0;
int asr_on = 0;
int asl_on = 0;
int dist = 0;          // 0 BASE, 1 PLUS, 2 MIDDLE, 3 LONG

int view_used = 0;
int t = 0;
int spin_ang = 0;
int spin_wait = 0;
int oled_dirty = TRUE;
int col = 0;
int save_dirty = FALSE;
int mask = 0;
int splash_on = TRUE;
int splash_t = 0;
int frame = 0;
int last_frame = -1;
int i = 0;
int n = 0;
int w = 0;
int offs[15];
int edit_on = FALSE;
int sel = 0;
int step = 0;
int v = 0;
int d = 0;
int started = 0;
int popup_t = 0;
int rep_t = 0;
int rep_dir = 0;
int reset_hold = 0;
int reset_done = FALSE;
int help_on = FALSE;
int page = 0;
int tap_wait = 0;
int idle_t = 0;
int saver_on = FALSE;
int saver_t = 0;
int profile = 0;
int pb = 0;
int ls_clean = FALSE;
int flash_t = 0;
int flash_double = FALSE;
int flash_white = FALSE;
int want_white = FALSE;
int popup_id = 0;
int popup_state = 0;
int layer_on = FALSE;

init {
    profile = get_pvar(SPVAR_1 + ACTIVE_INDEX, 0, PROFILE_COUNT - 1, 0);
    load_settings();
}

main {
    // ---------- BOOT SPLASH ----------
    if(splash_on) {
        splash_t = splash_t + get_rtime();
        frame = splash_t / SPLASH_FRAME_MS;
        if(frame >= SPLASH_FRAMES) {
            splash_on = FALSE;
            oled_dirty = TRUE;
        } else if(frame != last_frame) {
            draw_splash();
            last_frame = frame;
        }
    }

    // ---------- TIMING EDIT MODE ----------
    if(edit_on) {
        edit_mode();
    } else if(help_on) {
        help_mode();
    } else {

    // ---------- TOGGLE LAYER ----------
    layer_on = get_val(XB1_VIEW);
    if(layer_on) {
        if(event_press(XB1_MENU)) {
            edit_on = TRUE;
            popup_t = 0;
            view_used = 1;
            stop_all();
            oled_dirty = TRUE;
            combo_run(cVibrateOn);
        }
        set_val(XB1_MENU, 0);
        if(event_press(XB1_LT))    { aim_on   = toggle(aim_on, 0); }
        if(event_press(XB1_RT))    { rs_on    = toggle(rs_on, 4); }
        if(event_press(XB1_X))     { rt_on    = toggle(rt_on, 5); }
        if(event_press(XB1_A))     { horse_on = toggle(horse_on, 6); }
        if(event_press(XB1_Y))     { hat_on   = toggle(hat_on, 7); }
        if(event_press(XB1_B))     { tonic_on = toggle(tonic_on, 8); }
        if(event_press(XB1_DOWN))  { tspam_on = toggle(tspam_on, 9); }
        if(event_press(XB1_LEFT))  { spin_on  = toggle(spin_on, 10); }
        if(event_press(XB1_RIGHT)) { bat_on   = toggle(bat_on, 13); }
        if(event_press(XB1_RB))    { asr_on = toggle(asr_on, 11); if(asr_on) asl_on = 0; }
        if(event_press(XB1_LB))    { asl_on = toggle(asl_on, 12); if(asl_on) asr_on = 0; }
        if(event_press(XB1_UP)) {
            dist = dist + 1;
            if(dist > 3) dist = 0;
            show_popup(POPUP_DIST, 1);
            view_used = 1;
            oled_dirty = TRUE;
            save_dirty = TRUE;
            combo_run(cVibrateOn);
        }
        if(event_press(XB1_LS)) ls_clean = TRUE;
        if(get_val(XB1_RS)) ls_clean = FALSE;
        if(event_release(XB1_LS) && ls_clean && get_ptime(XB1_LS) < 400) {
            ls_clean = FALSE;
            view_used = 1;
            next_profile();
        }
        if(get_val(XB1_LS) && get_val(XB1_RS)) {
            view_used = 1;
            reset_hold = reset_hold + get_rtime();
            if(reset_hold >= RESET_HOLD_MS && !reset_done) {
                factory_reset();
                reset_done = TRUE;
            }
        } else {
            reset_hold = 0;
            reset_done = FALSE;
        }
        block_layer();
        set_val(XB1_LS, 0);
        set_val(XB1_RS, 0);
        set_val(XB1_VIEW, 0);
    }
    if(event_release(XB1_VIEW)) {
        if(!view_used && get_ptime(XB1_VIEW) < 250) {
            if(tap_wait > 0) {
                tap_wait = 0;
                help_on = TRUE;
                page = 0;
                popup_t = 0;
                stop_all();
                oled_dirty = TRUE;
            } else {
                tap_wait = DOUBLE_TAP_MS;
            }
        }
        view_used = 0;
        if(save_dirty) {
            save_settings();
            save_dirty = FALSE;
        }
    }

    // ---------- MODS (paused while VIEW is held for toggling) ----------
    if(layer_on) {
        stop_all();
    } else {

    // ---------- AIM ASSIST / DISTANCE PROFILES ----------
    if(aim_on && get_val(XB1_LT) && !get_val(XB1_RT)) {
        if(dist == 0) combo_run(cAimAssist);
        if(dist == 1) combo_run(cPlusDistance);
        if(dist == 2) combo_run(cMiddleDistance);
        if(dist == 3) combo_run(cLongDistance);
    } else {
        combo_stop(cAimAssist);
        combo_stop(cPlusDistance);
        combo_stop(cMiddleDistance);
        combo_stop(cLongDistance);
    }

    // ---------- RS PRESS (Dead Eye on aim) ----------
    if(rs_on && event_press(XB1_LT)) combo_run(cRSPress);

    // ---------- RT PRESS (rapid fire) ----------
    if(rt_on && get_val(XB1_RT)) combo_run(cRTPress);
    else combo_stop(cRTPress);

    // ---------- RUN HORSE ----------
    if(horse_on && get_val(XB1_A)) combo_run(cRunHorse);
    else combo_stop(cRunHorse);

    // ---------- HAT ----------
    if(hat_on && event_press(XB1_UP)) combo_run(cHat);
    if(hat_on) set_val(XB1_UP, 0);

    // ---------- TONICS / TONIC SPAM ----------
    if(tspam_on && get_val(XB1_RB)) {
        combo_run(cTonicSpam);
        set_val(XB1_RB, 0);
    } else combo_stop(cTonicSpam);
    if(tonic_on) {
        if(event_press(XB1_RIGHT)) combo_run(cTonics);
        set_val(XB1_RIGHT, 0);
    }

    // ---------- BASE SPIN (LS full circle) ----------
    if(spin_on && get_val(XB1_LEFT)) {
        set_val(XB1_LEFT, 0);
        combo_run(cBaseSpin);
    } else {
        combo_stop(cBaseSpin);
        spin_ang = 0;
    }

    // ---------- AUTOSPIN (camera, pauses while aiming / touching RS) ----------
    if((asr_on || asl_on) && !get_val(XB1_LT) && abs(get_val(XB1_RX)) < DZ && abs(get_val(XB1_RY)) < DZ) {
        if(asr_on) combo_run(cAutospinRight);
        if(asl_on) combo_run(cAutospinLeft);
    } else {
        combo_stop(cAutospinRight);
        combo_stop(cAutospinLeft);
    }

    // ---------- LOW BATTERY (anti-idle when LS untouched) ----------
    if(bat_on && abs(get_val(XB1_LX)) < DZ && abs(get_val(XB1_LY)) < DZ) combo_run(cLowBattery);
    else combo_stop(cLowBattery);

    }

    }

    // ---------- SINGLE VIEW TAP (sent once double-tap window passes) ----------
    if(tap_wait > 0 && !get_val(XB1_VIEW)) {
        tap_wait = tap_wait - get_rtime();
        if(tap_wait <= 0) { tap_wait = 0; if(!help_on) combo_run(cTapView); }
    }

    // ---------- SCREEN SAVER WAKE (VIEW press shows the menu again) ----------
    if(saver_on && event_press(XB1_VIEW)) oled_dirty = TRUE;

    // ---------- LED FLASH (1 flash = ON, 2 flashes = OFF) ----------
    if(flash_t > 0) {
        flash_t = flash_t - get_rtime();
        want_white = flash_t > 0;
        if(flash_double && flash_t <= FLASH_ON_MS + FLASH_GAP_MS && flash_t > FLASH_ON_MS) want_white = FALSE;
        if(want_white != flash_white) {
            flash_white = want_white;
            update_led();
        }
    }

    // ---------- POPUP TIMER ----------
    if(popup_t > 0) {
        popup_t = popup_t - get_rtime();
        if(popup_t <= 0) { popup_t = 0; oled_dirty = TRUE; }
    }

    // ---------- OLED MENU (redraws only on change) ----------
    if(oled_dirty && !splash_on) {
        update_led();
        if(edit_on) draw_edit();
        else if(help_on) draw_help();
        else {
            draw_menu();
            if(popup_t > 0) draw_popup();
        }
        idle_t = 0;
        saver_on = FALSE;
        oled_dirty = FALSE;
    }

    // ---------- SCREEN SAVER (after 60s with no screen changes) ----------
    if(!splash_on && !edit_on && !help_on) {
        if(idle_t < SAVER_MS) idle_t = idle_t + get_rtime();
        if(idle_t >= SAVER_MS) {
            if(!saver_on) { saver_on = TRUE; saver_t = 0; }
            saver_t = saver_t - get_rtime();
            if(saver_t <= 0) { draw_saver(); saver_t = SAVER_MOVE_MS; }
        }
    }
}

// ================= FUNCTIONS =================
function toggle(state, id) {
    view_used = 1;
    start_flash(state);
    save_dirty = TRUE;
    show_popup(id, !state);
    if(state) { combo_run(cVibrateOff); return 0; }
    combo_run(cVibrateOn);
    return 1;
}

// LED mix: RED = combat (AIM/RS/RT), GREEN = movement (HORSE/SPIN/AUTOSPIN),
// BLUE = utility (HAT/TONICS/SPAM/BATTERY). More mods in a group = brighter.
// White = timing edit mode, dim grey = nothing on.
function update_led() {
    i = (aim_on + rs_on + rt_on) * 85;
    n = (horse_on + spin_on + asr_on + asl_on) * 85;
    w = (hat_on + tonic_on + tspam_on + bat_on) * 63;
    if(i > 255) i = 255;
    if(n > 255) n = 255;
    if(flash_white) set_rgb(255, 255, 255);
    else if(edit_on) set_rgb(255, 255, 255);
    else if(!i && !n && !w) set_rgb(10, 10, 10);
    else set_rgb(i, n, w);
}

// Saves the current profile, then loads the next one (PVP > HUNT > HORSE)
function next_profile() {
    save_settings();
    save_dirty = FALSE;
    stop_all();
    profile = profile + 1;
    if(profile >= PROFILE_COUNT) profile = 0;
    load_settings();
    set_pvar(SPVAR_1 + ACTIVE_INDEX, profile);
    show_popup(POPUP_PROFILE, 1);
    combo_run(cVibrateOn);
}

// All mods off, aim distance BASE, every timing back to its original value
function factory_reset() {
    aim_on = 0; rs_on = 0; rt_on = 0; horse_on = 0; hat_on = 0; tonic_on = 0;
    tspam_on = 0; spin_on = 0; asr_on = 0; asl_on = 0; bat_on = 0;
    dist = 0;
    sel = 0;
    for(i = 0; i < T_COUNT; i = i + 1) {
        offs[i] = 0;
    }
    stop_all();
    save_settings();
    save_dirty = FALSE;
    show_popup(POPUP_RESET, 1);
    combo_run(cResetRumble);
}

function start_flash(was_on) {
    flash_double = was_on;
    flash_t = FLASH_ON_MS;
    if(flash_double) flash_t = FLASH_ON_MS + FLASH_GAP_MS + FLASH_ON_MS;
    flash_white = TRUE;
    update_led();
}

function show_popup(id, on) {
    popup_id = id;
    popup_state = on;
    popup_t = POPUP_MS;
    oled_dirty = TRUE;
}

// White box over the menu: mod name + ON/OFF (or new aim distance)
function draw_popup() {
    rect_oled(1, 12, 126, 40, TRUE, OLED_WHITE);
    rect_oled(3, 14, 122, 36, FALSE, OLED_BLACK);
    if(popup_id == 0)  printf(5, 16, OLED_FONT_MEDIUM, OLED_BLACK, N0[0]);
    if(popup_id == 4)  printf(5, 16, OLED_FONT_MEDIUM, OLED_BLACK, N4[0]);
    if(popup_id == 5)  printf(5, 16, OLED_FONT_MEDIUM, OLED_BLACK, N5[0]);
    if(popup_id == 6)  printf(5, 16, OLED_FONT_MEDIUM, OLED_BLACK, N6[0]);
    if(popup_id == 7)  printf(5, 16, OLED_FONT_MEDIUM, OLED_BLACK, N7[0]);
    if(popup_id == 8)  printf(5, 16, OLED_FONT_MEDIUM, OLED_BLACK, N8[0]);
    if(popup_id == 9)  printf(5, 16, OLED_FONT_MEDIUM, OLED_BLACK, N9[0]);
    if(popup_id == 10) printf(5, 16, OLED_FONT_MEDIUM, OLED_BLACK, N10[0]);
    if(popup_id == 11) printf(5, 16, OLED_FONT_MEDIUM, OLED_BLACK, N11[0]);
    if(popup_id == 12) printf(5, 16, OLED_FONT_MEDIUM, OLED_BLACK, N12[0]);
    if(popup_id == 13) printf(5, 16, OLED_FONT_MEDIUM, OLED_BLACK, N13[0]);
    if(popup_id == POPUP_PROFILE) {
        printf(25, 16, OLED_FONT_MEDIUM, OLED_BLACK, S_PROFILE[0]);
        if(profile == 0) printf(48, 33, OLED_FONT_MEDIUM, OLED_BLACK, P0[0]);
        if(profile == 1) printf(42, 33, OLED_FONT_MEDIUM, OLED_BLACK, P1[0]);
        if(profile == 2) printf(37, 33, OLED_FONT_MEDIUM, OLED_BLACK, P2[0]);
    } else if(popup_id == POPUP_RESET) {
        printf(14, 16, OLED_FONT_MEDIUM, OLED_BLACK, S_RESET[0]);
        printf(42, 33, OLED_FONT_MEDIUM, OLED_BLACK, S_DONE[0]);
    } else if(popup_id == POPUP_DIST) {
        printf(5, 16, OLED_FONT_MEDIUM, OLED_BLACK, S_ADIST[0]);
        if(dist == 0) printf(42, 33, OLED_FONT_MEDIUM, OLED_BLACK, S_BASE[0]);
        if(dist == 1) printf(42, 33, OLED_FONT_MEDIUM, OLED_BLACK, S_PLUS[0]);
        if(dist == 2) printf(31, 33, OLED_FONT_MEDIUM, OLED_BLACK, S_MID[0]);
        if(dist == 3) printf(42, 33, OLED_FONT_MEDIUM, OLED_BLACK, S_LONG[0]);
    } else {
        if(popup_state) printf(53, 33, OLED_FONT_MEDIUM, OLED_BLACK, S_ON[0]);
        else printf(48, 33, OLED_FONT_MEDIUM, OLED_BLACK, S_OFF[0]);
    }
}

// Saved as one packed value: bits 0-10 = mods, bits 11-12 = aim distance
function save_settings() {
    mask = aim_on + (rs_on << 1) + (rt_on << 2) + (horse_on << 3)
         + (hat_on << 4) + (tonic_on << 5) + (tspam_on << 6) + (spin_on << 7)
         + (asr_on << 8) + (asl_on << 9) + (bat_on << 10) + (dist << 11);
    pb = PROFILE_BASE + (profile * PROFILE_SIZE);
    set_pvar(SPVAR_1 + pb, mask);
    for(i = 0; i < T_COUNT; i = i + 1) {
        set_pvar(SPVAR_1 + pb + 1 + i, offs[i]);
    }
    set_pvar(SPVAR_1 + pb + PROFILE_MAGIC_OFS, MAGIC);
    set_pvar(SPVAR_1 + ACTIVE_INDEX, profile);
}

function load_settings() {
    pb = PROFILE_BASE + (profile * PROFILE_SIZE);
    mask = PRESET[profile];
    if(get_pvar(SPVAR_1 + pb + PROFILE_MAGIC_OFS, 0, 9999, 0) == MAGIC) {
        mask = get_pvar(SPVAR_1 + pb, 0, SAVE_MAX, 0);
    }
    aim_on   = mask & 1;
    rs_on    = (mask >> 1) & 1;
    rt_on    = (mask >> 2) & 1;
    horse_on = (mask >> 3) & 1;
    hat_on   = (mask >> 4) & 1;
    tonic_on = (mask >> 5) & 1;
    tspam_on = (mask >> 6) & 1;
    spin_on  = (mask >> 7) & 1;
    asr_on   = (mask >> 8) & 1;
    asl_on   = (mask >> 9) & 1;
    bat_on   = (mask >> 10) & 1;
    dist     = (mask >> 11) & 3;
    if(asr_on && asl_on) asl_on = 0;
    for(i = 0; i < T_COUNT; i = i + 1) {
        offs[i] = 0;
        if(get_pvar(SPVAR_1 + pb + PROFILE_MAGIC_OFS, 0, 9999, 0) == MAGIC) {
            offs[i] = get_pvar(SPVAR_1 + pb + 1 + i, -OFF_LIMIT, OFF_LIMIT, 0);
        }
    }
    oled_dirty = TRUE;
}

// Random timing for mod idx: base range + your live offset
function tm(idx) {
    v = random(T_MIN[idx] + offs[idx], T_MAX[idx] + offs[idx]);
    if(v < T_FLOOR) v = T_FLOOR;
    return v;
}

// D-pad L/R = pick mod, Up/Down = +/-5ms (hold RB = +/-50ms), Y = reset, B or MENU = save & exit
function edit_mode() {
    if(event_press(XB1_RIGHT)) { sel = sel + 1; if(sel >= T_COUNT) sel = 0; oled_dirty = TRUE; }
    if(event_press(XB1_LEFT))  { sel = sel - 1; if(sel < 0) sel = T_COUNT - 1; oled_dirty = TRUE; }
    step = STEP_SMALL;
    if(get_val(XB1_RB)) step = STEP_BIG;
    rep_dir = 0;
    if(event_press(XB1_UP))   { rep_dir = 1;  rep_t = REPEAT_DELAY; }
    if(event_press(XB1_DOWN)) { rep_dir = -1; rep_t = REPEAT_DELAY; }
    if(!rep_dir && (get_val(XB1_UP) || get_val(XB1_DOWN))) {
        rep_t = rep_t - get_rtime();
        if(rep_t <= 0) {
            rep_dir = 1;
            if(get_val(XB1_DOWN)) rep_dir = -1;
            rep_t = REPEAT_RATE;
            if(get_ptime(XB1_UP) > REPEAT_TURBO_AFTER || get_ptime(XB1_DOWN) > REPEAT_TURBO_AFTER) rep_t = REPEAT_TURBO;
        }
    }
    if(rep_dir) { offs[sel] = offs[sel] + (rep_dir * step); oled_dirty = TRUE; }
    if(offs[sel] > OFF_LIMIT) offs[sel] = OFF_LIMIT;
    if(offs[sel] < -OFF_LIMIT) offs[sel] = -OFF_LIMIT;
    if(event_press(XB1_Y)) { offs[sel] = 0; oled_dirty = TRUE; }
    if(event_press(XB1_B) || event_press(XB1_MENU)) {
        edit_on = FALSE;
        view_used = 0;
        save_settings();
        save_dirty = FALSE;
        oled_dirty = TRUE;
        combo_run(cVibrateOff);
    }
    block_layer();
    set_val(XB1_MENU, 0);
    set_val(XB1_VIEW, 0);
}

// Blank screen with a small drifting logo (no OLED brightness control, so blank = dim)
function draw_saver() {
    cls_oled(OLED_BLACK);
    printf(random(0, 50), random(0, 53), OLED_FONT_SMALL, OLED_WHITE, TITLE[0]);
}

// D-pad Left/Right = page, B = close
function help_mode() {
    if(event_press(XB1_RIGHT)) { page = page + 1; if(page >= HELP_PAGES) page = 0; oled_dirty = TRUE; }
    if(event_press(XB1_LEFT))  { page = page - 1; if(page < 0) page = HELP_PAGES - 1; oled_dirty = TRUE; }
    if(event_press(XB1_B)) {
        help_on = FALSE;
        oled_dirty = TRUE;
    }
    block_layer();
    set_val(XB1_MENU, 0);
    set_val(XB1_VIEW, 0);
}

