function stop_all() {
    combo_stop(cAimAssist);      combo_stop(cPlusDistance);
    combo_stop(cMiddleDistance); combo_stop(cLongDistance);
    combo_stop(cRSPress);        combo_stop(cRTPress);
    combo_stop(cRunHorse);       combo_stop(cHat);
    combo_stop(cTonics);         combo_stop(cTonicSpam);
    combo_stop(cBaseSpin);       combo_stop(cAutospinRight);
    combo_stop(cAutospinLeft);   combo_stop(cLowBattery);
}

// Appends a signed number to the OLED text buffer at position n+1
function put_num(num) {
    if(num < 0) { n = n + 1; putc_oled(n, 45); num = -num; }
    d = 1000;
    started = FALSE;
    while(d > 0) {
        v = (num / d) % 10;
        if(v || started || d == 1) { n = n + 1; putc_oled(n, 48 + v); started = TRUE; }
        d = d / 10;
    }
}

function put_range(lo, hi, x, y) {
    n = 0;
    put_num(lo);
    n = n + 1; putc_oled(n, 45);
    put_num(hi);
    puts_oled(x, y, OLED_FONT_SMALL, n, OLED_WHITE);
}

function draw_edit() {
    cls_oled(OLED_BLACK);
    printf(0, 0, OLED_FONT_SMALL, OLED_WHITE, S_EDIT[0]);
    n = 0;
    put_num(sel + 1); n = n + 1; putc_oled(n, 47); put_num(T_COUNT);
    puts_oled(128 - (n * 7), 0, OLED_FONT_SMALL, n, OLED_WHITE);
    line_oled(0, 11, 127, 11, 1, OLED_WHITE);

    if(sel == 0)  printf(0, 14, OLED_FONT_MEDIUM, OLED_WHITE, N0[0]);
    if(sel == 1)  printf(0, 14, OLED_FONT_MEDIUM, OLED_WHITE, N1[0]);
    if(sel == 2)  printf(0, 14, OLED_FONT_MEDIUM, OLED_WHITE, N2[0]);
    if(sel == 3)  printf(0, 14, OLED_FONT_MEDIUM, OLED_WHITE, N3[0]);
    if(sel == 4)  printf(0, 14, OLED_FONT_MEDIUM, OLED_WHITE, N4[0]);
    if(sel == 5)  printf(0, 14, OLED_FONT_MEDIUM, OLED_WHITE, N5[0]);
    if(sel == 6)  printf(0, 14, OLED_FONT_MEDIUM, OLED_WHITE, N6[0]);
    if(sel == 7)  printf(0, 14, OLED_FONT_MEDIUM, OLED_WHITE, N7[0]);
    if(sel == 8)  printf(0, 14, OLED_FONT_MEDIUM, OLED_WHITE, N8[0]);
    if(sel == 9)  printf(0, 14, OLED_FONT_MEDIUM, OLED_WHITE, N9[0]);
    if(sel == 10) printf(0, 14, OLED_FONT_MEDIUM, OLED_WHITE, N10[0]);
    if(sel == 11) printf(0, 14, OLED_FONT_MEDIUM, OLED_WHITE, N11[0]);
    if(sel == 12) printf(0, 14, OLED_FONT_MEDIUM, OLED_WHITE, N12[0]);
    if(sel == 13) printf(0, 14, OLED_FONT_MEDIUM, OLED_WHITE, N13[0]);
    if(sel == 14) printf(0, 14, OLED_FONT_MEDIUM, OLED_WHITE, N14[0]);

    printf(0, 34, OLED_FONT_SMALL, OLED_WHITE, S_BASEL[0]);
    put_range(T_MIN[sel], T_MAX[sel], 35, 34);

    printf(0, 44, OLED_FONT_SMALL, OLED_WHITE, S_OFFS[0]);
    n = 0;
    if(offs[sel] >= 0) { n = n + 1; putc_oled(n, 43); }
    put_num(offs[sel]);
    puts_oled(35, 44, OLED_FONT_SMALL, n, OLED_WHITE);

    printf(0, 54, OLED_FONT_SMALL, OLED_WHITE, S_NOW[0]);
    v = T_MIN[sel] + offs[sel]; if(v < T_FLOOR) v = T_FLOOR; w = v;
    v = T_MAX[sel] + offs[sel]; if(v < T_FLOOR) v = T_FLOOR;
    put_range(w, v, 35, 54);
}

// Type-on title > growing underline > subtitle > double flash
function draw_splash() {
    col = OLED_WHITE;
    if(frame == 24 || frame == 26) col = OLED_BLACK;
    cls_oled(!col);

    n = frame + 1;
    if(n > SPLASH_LEN) n = SPLASH_LEN;
    for(i = 0; i < n; i = i + 1) {
        putc_oled(i + 1, SPLASH[i]);
    }
    puts_oled(3, 10, OLED_FONT_MEDIUM, n, col);
    if(frame < SPLASH_LEN - 1) rect_oled(3 + (n * 11), 10, 2, 18, TRUE, col);

    if(frame >= SPLASH_LEN) {
        w = (frame - SPLASH_LEN + 1) * 6;
        if(w > 60) w = 60;
        line_oled(64 - w, 32, 64 + w, 32, 2, col);
    }
    if(frame >= 16) printf(11, 42, OLED_FONT_SMALL, col, S_SUB[0]);
}

// Inverted (filled) cell = mod ON
function cell(x, y, on) {
    col = OLED_WHITE;
    if(on) {
        rect_oled(x, y, 31, 10, TRUE, OLED_WHITE);
        col = OLED_BLACK;
    }
}

function draw_menu() {
    cls_oled(OLED_BLACK);
    printf(3, 1, OLED_FONT_MEDIUM, OLED_WHITE, TITLE[0]);
    line_oled(0, 20, 127, 20, 1, OLED_WHITE);

    cell(0, 22, aim_on);    printf(5, 22, OLED_FONT_SMALL, col, S_AIM[0]);
    cell(32, 22, rs_on);    printf(41, 22, OLED_FONT_SMALL, col, S_RS[0]);
    cell(64, 22, rt_on);    printf(73, 22, OLED_FONT_SMALL, col, S_RT[0]);
    cell(96, 22, horse_on); printf(101, 22, OLED_FONT_SMALL, col, S_HRS[0]);

    cell(0, 33, hat_on);    printf(5, 33, OLED_FONT_SMALL, col, S_HAT[0]);
    cell(32, 33, tonic_on); printf(37, 33, OLED_FONT_SMALL, col, S_TON[0]);
    cell(64, 33, tspam_on); printf(69, 33, OLED_FONT_SMALL, col, S_SPM[0]);
    cell(96, 33, spin_on);  printf(101, 33, OLED_FONT_SMALL, col, S_SPN[0]);

    cell(0, 44, asr_on);    printf(5, 44, OLED_FONT_SMALL, col, S_ASR[0]);
    cell(32, 44, asl_on);   printf(37, 44, OLED_FONT_SMALL, col, S_ASL[0]);
    cell(64, 44, bat_on);   printf(69, 44, OLED_FONT_SMALL, col, S_BAT[0]);

    printf(0, 54, OLED_FONT_SMALL, OLED_WHITE, S_DIST[0]);
    if(dist == 0) printf(42, 54, OLED_FONT_SMALL, OLED_WHITE, S_BASE[0]);
    if(dist == 1) printf(42, 54, OLED_FONT_SMALL, OLED_WHITE, S_PLUS[0]);
    if(dist == 2) printf(42, 54, OLED_FONT_SMALL, OLED_WHITE, S_MID[0]);
    if(dist == 3) printf(42, 54, OLED_FONT_SMALL, OLED_WHITE, S_LONG[0]);

    rect_oled(90, 53, 38, 11, TRUE, OLED_WHITE);
    if(profile == 0) printf(99, 54, OLED_FONT_SMALL, OLED_BLACK, P0[0]);
    if(profile == 1) printf(95, 54, OLED_FONT_SMALL, OLED_BLACK, P1[0]);
    if(profile == 2) printf(92, 54, OLED_FONT_SMALL, OLED_BLACK, P2[0]);
}

function block_layer() {
    set_val(XB1_LT, 0);    set_val(XB1_RT, 0);
    set_val(XB1_LB, 0);    set_val(XB1_RB, 0);
    set_val(XB1_A, 0);     set_val(XB1_B, 0);
    set_val(XB1_X, 0);     set_val(XB1_Y, 0);
    set_val(XB1_UP, 0);    set_val(XB1_DOWN, 0);
    set_val(XB1_LEFT, 0);  set_val(XB1_RIGHT, 0);
}

// ================= COMBOS =================
// AIM_ASSIST - 4 steps, 681-690
combo cAimAssist {
    t = tm(0);
    set_val(XB1_LT, 0);
    wait(TAP);
    set_val(XB1_LT, 100);
    wait(t);
    set_val(XB1_LT, 0);
    wait(TAP);
    set_val(XB1_LT, 100);
    wait(t);
}

// PLUS_DISTANCE - 2 steps, 41-50
combo cPlusDistance {
    t = tm(1);
    set_val(XB1_LT, 0);
    wait(TAP);
    set_val(XB1_LT, 100);
    wait(t);
}

// MIDDLE_DISTANCE - 4 steps, 381-390
combo cMiddleDistance {
    t = tm(2);
    set_val(XB1_LT, 0);
    wait(TAP);
    set_val(XB1_LT, 100);
    wait(t);
    set_val(XB1_LT, 0);
    wait(TAP);
    set_val(XB1_LT, 100);
    wait(t);
}

// LONG_DISTANCE - 3 steps, N/A (default 900)
combo cLongDistance {
    t = tm(3);
    set_val(XB1_LT, 0);
    wait(TAP);
    set_val(XB1_LT, 100);
    wait(t);
    set_val(XB1_LT, 100);
    wait(TAP);
}

// RS_PRESS - 4 steps, N/A (default 60)
combo cRSPress {
    t = tm(4);
    wait(t);
    set_val(DEADEYE_BTN, 100);
    wait(t);
    set_val(DEADEYE_BTN, 0);
    wait(t);
    wait(t);
}

// RT_PRESS - 3 steps, 101-110
combo cRTPress {
    t = tm(5);
    set_val(XB1_RT, 100);
    wait(TAP);
    set_val(XB1_RT, 0);
    wait(t);
    wait(TAP);
}

// RUN_HORSE - 3 steps, 151-160
combo cRunHorse {
    t = tm(6);
    set_val(XB1_A, 100);
    wait(TAP);
    set_val(XB1_A, 0);
    wait(t);
    wait(TAP);
}

// HAT - 6 steps, 859-880
combo cHat {
    t = tm(7);
    set_val(HAT_BTN, 100);
    wait(t);
    set_val(HAT_BTN, 0);
    wait(TAP);
    set_val(HAT_BTN, 100);
    wait(t);
    set_val(HAT_BTN, 0);
    wait(TAP);
    set_val(HAT_BTN, 100);
    wait(TAP);
    set_val(HAT_BTN, 0);
    wait(TAP);
}

// TONICS - 4 steps, 241-250
combo cTonics {
    t = tm(8);
    set_val(TONIC_WHEEL, 100);
    wait(t);
    set_val(TONIC_WHEEL, 100);
    set_val(TONIC_TAB, 100);
    wait(t);
    set_val(TONIC_WHEEL, 100);
    set_val(TONIC_USE, 100);
    wait(t);
    set_val(TONIC_WHEEL, 0);
    set_val(TONIC_USE, 0);
    wait(t);
}

// tonicspam - 3 steps, 111-130
combo cTonicSpam {
    t = tm(9);
    if(t < TAP) t = TAP;
    set_val(TONIC_WHEEL, 100);
    set_val(TONIC_TAB, 100);
    wait(TAP);
    set_val(TONIC_WHEEL, 0);
    set_val(TONIC_TAB, 0);
    wait(t - TAP);
}

// basespin - 22 steps per full circle, 531-540 ms per rotation
combo cBaseSpin {
    spin_wait = tm(10) / SPIN_STEPS;
    set_polar(POLAR_LS, spin_ang, 32767);
    wait(spin_wait);
    spin_ang = spin_ang + (360 / SPIN_STEPS);
    if(spin_ang >= 360) spin_ang = spin_ang - 360;
}

// autospin_right - 3 steps, 582-600
combo cAutospinRight {
    t = tm(11);
    set_val(XB1_RX, 100);
    wait(t);
    set_val(XB1_RX, 100);
    wait(t);
    set_val(XB1_RX, 0);
    wait(TAP);
}

// autospin_left - 4 steps, 662-680
combo cAutospinLeft {
    t = tm(12);
    set_val(XB1_RX, -100);
    wait(t);
    set_val(XB1_RX, -100);
    wait(t);
    set_val(XB1_RX, -100);
    wait(t);
    set_val(XB1_RX, 0);
    wait(TAP);
}

// LOW_BATTERY - 3 steps, 2001-2010
combo cLowBattery {
    t = tm(13);
    set_val(XB1_LY, -30);
    wait(100);
    set_val(XB1_LY, 0);
    wait(t);
    set_val(XB1_LY, 30);
    wait(100);
}

// vibrate - 2 steps, 201-210
combo cVibrateOn {
    t = tm(14);
    set_rumble(RUMBLE_A, 100);
    wait(t);
    reset_rumble();
    wait(t);
}

combo cVibrateOff {
    t = tm(14);
    set_rumble(RUMBLE_B, 60);
    wait(t);
    reset_rumble();
    wait(t);
}

combo cResetRumble {
    set_rumble(RUMBLE_A, 100);
    set_rumble(RUMBLE_B, 100);
    wait(600);
    reset_rumble();
    wait(40);
}

combo cTapView {
    set_val(XB1_VIEW, 100);
    wait(80);
    set_val(XB1_VIEW, 0);
    wait(40);
}                 
          
